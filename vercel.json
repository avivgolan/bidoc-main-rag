{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300,
        "includeFiles": [
          "node_modules/pdfjs-dist/cmaps/**",
          "node_modules/pdfjs-dist/standard_fonts/**",
          "node_modules/pdfjs-dist/legacy/build/**",
          "node_modules/@napi-rs/canvas/**",
          "node_modules/@napi-rs/canvas-linux-x64-gnu/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/src/server.js" }
  ]
}
